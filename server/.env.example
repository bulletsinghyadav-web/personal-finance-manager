# Copy to .env for local development.

# PostgreSQL connection strings for the dev and test databases.
DATABASE_URL=postgresql://postgres:postgres_dev_pw@localhost:5432/finance_dev?schema=public
TEST_DATABASE_URL=postgresql://postgres:postgres_dev_pw@localhost:5432/finance_test?schema=public

# JWT secrets - use long, random values in any real deployment.
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

PORT=4000
NODE_ENV=development

# Must match the frontend's origin exactly (scheme + host + port).
CLIENT_ORIGIN=http://localhost:5178

# Set to true in production when served over HTTPS.
COOKIE_SECURE=false

EXCHANGE_RATE_PROVIDER=static

# Optional SMTP configuration for password reset emails.
# Leave blank to use development mode (reset links are logged to the server
# console instead of emailed, and are never included in API responses).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Finance App <no-reply@example.com>
